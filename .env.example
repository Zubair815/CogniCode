# ================= LLM =================
# Supported providers: "groq" | "claude" | "ollama"
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-latest
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ================= POSTGRES (DOCKER COMPOSE) =================
POSTGRES_USER=cognicode
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=cognicode

# ================= DATABASE (PostgreSQL) =================
DATABASE_URL=postgresql://user:password@localhost:5432/cognicode
CHROMA_PERSIST_DIR=./data/chroma

# ================= AUTH =================
# Must be at least 32 random characters in all environments
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
WS_TICKET_EXPIRE_SECONDS=60
INSTRUCTOR_INVITE_CODE=replace_with_institutional_invite_code

# ================= APP =================
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ================= CDS WEIGHTS (BR-08) =================
CDS_WEIGHT_SOLUTION_REQUEST=0.25
CDS_WEIGHT_HINT_LEVEL=0.25
CDS_WEIGHT_RETRY=0.15
CDS_WEIGHT_TIME_GAP=0.10
CDS_WEIGHT_DEBUGGING=0.15
CDS_WEIGHT_QUIZ=0.10
