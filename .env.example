# ================= LLM =================
# Supported providers: "groq" | "claude" | "ollama"
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-latest
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ================= DATABASE =================
# Default local SQLite database:
DATABASE_URL=sqlite:///./cognicode.db
# Or PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cognicode
CHROMA_PERSIST_DIR=./data/chroma

# ================= AUTH =================
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ================= APP =================
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ================= CDS WEIGHTS (BR-08) =================
CDS_WEIGHT_SOLUTION_REQUEST=0.25
CDS_WEIGHT_HINT_LEVEL=0.25
CDS_WEIGHT_RETRY=0.15
CDS_WEIGHT_TIME_GAP=0.10
CDS_WEIGHT_DEBUGGING=0.15
CDS_WEIGHT_QUIZ=0.10
